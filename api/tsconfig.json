{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["shared/**/*.ts", "planTrip/**/*.ts", "sendOtp/**/*.ts", "sendEmail/**/*.ts", "generateCode/**/*.ts"]
}
